/* Open APU Studio — Café Theme */
/* Palette: earthy brown tones */

* {
    font-family: "Inter", "Segoe UI", "Segoe UI Variable Text", sans-serif;
    color: #EDE4D8;
}

QMainWindow, QDialog, QWidget {
    background-color: #171410;
    color: #EDE4D8;
}

/* ── Barra superior ── */
QMenuBar {
    background-color: #201D18;
    color: #EDE4D8;
    border-bottom: 1px solid #2A241D;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected {
    background-color: #2A241D;
    border-radius: 4px;
}
QMenu {
    background-color: #201D18;
    color: #EDE4D8;
    border: 1px solid #2A241D;
    padding: 4px;
}
QMenu::item:selected {
    background-color: #2A241D;
    border-radius: 4px;
}

/* ── Toolbar ── */
#tbCustom {
    background-color: #2A241D;
    border-bottom: 1px solid #2A241D;
}
#tbCustom > QWidget {
    background-color: transparent;
}
#tbGroup, #tbGroup * {
    background-color: transparent;
    border: none;
}

#tbSep {
    background-color: #2A241D;
    margin: 4px 6px;
}

/* ── Pestañas superiores (PROYECTO, INICIO, …) ── */
#tabBar {
    background-color: #201D18;
    border-bottom: 1px solid #2A241D;
}
#tabBar QPushButton {
    background-color: transparent;
    color: #C0B4A4;
    border: none;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 18px;
}
#tabBar QPushButton:hover {
    color: #EDE4D8;
    background-color: #2A241D;
}
#tabBar QPushButton:checked {
    color: #C49A6C;
    background-color: #171410;
}

/* ── Search bar ── */
#searchBar {
    background-color: #201D18;
    border-bottom: 1px solid #2A241D;
}
#searchInput {
    background-color: #171410;
    color: #EDE4D8;
    border: 1px solid #352E24;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    min-height: 20px;
}
#searchInput:focus {
    border: 1px solid #A87C4E;
}
QToolButton {
    background-color: transparent;
    color: #EDE4D8;
    border: none;
    outline: none;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10px;
    min-height: 40px;
    min-width: 48px;
}
QToolButton:hover {
    background-color: #2A241D;
}
#tbStackedBtn {
    padding: 0 6px;
    text-align: left;
    min-height: 0px;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #2A241D;
    width: 2px;
}

/* ── Tablas y árbol ── */
QTreeView, QTableView {
    background-color: #171410;
    alternate-background-color: #1E1B16;
    color: #EDE4D8;
    gridline-color: #2A241D;
    selection-background-color: #7A5C3A;
    selection-color: #EDE4D8;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 4px 8px;
    min-height: 28px;
    border: none;
}
QTreeView::item:hover {
    background: #25201A;
}
QTreeView::item:selected {
    background: #352E24;
}
QTreeView::item:selected:focus {
    background: #A87C4E;
}
QTreeView::branch {
    background: transparent;
}
QTreeView::branch:hover {
    background: #25201A;
}
QTreeView::branch:selected {
    background: #352E24;
}
QHeaderView::section {
    background-color: #2A241D;
    color: #EDE4D8;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #352E24;
    border-right: 1px solid #352E24;
    font-weight: bold;
    font-size: 12px;
}

/* ── Pestañas ── */
QTabWidget::pane {
    background-color: #171410;
    border: none;
    border-top: 1px solid #2A241D;
}
QTabBar::tab {
    background-color: #201D18;
    color: #C0B4A4;
    padding: 8px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-size: 13px;
}
QTabBar::tab:selected {
    color: #C49A6C;
    border-bottom: 2px solid #A87C4E;
    background-color: #171410;
}
QTabBar::tab:hover {
    color: #EDE4D8;
}

/* ── Botones ── */
QPushButton {
    background-color: transparent;
    color: #EDE4D8;
    border: 1px solid #352E24;
    border-radius: 4px;
    padding: 4px 16px;
    font-size: 13px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #2A241D;
    border-color: #A87C4E;
}
QPushButton:pressed {
    background-color: #352E24;
}
QPushButton#btnPrimario {
    background-color: #7A5C3A;
    color: #EDE4D8;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}
QPushButton#btnPrimario:hover {
    background-color: #A87C4E;
}

/* ── Inputs ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #171410;
    color: #EDE4D8;
    border: 1px solid #2A241D;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #A87C4E;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #887A6A;
    margin-right: 4px;
}
QComboBox:hover::down-arrow {
    border-top-color: #EDE4D8;
}

/* ── GroupBox ── */
QGroupBox {
    border: none;
    font-weight: bold;
    font-size: 13px;
    margin-top: 12px;
    padding-top: 4px;
}

/* ── StatusBar ── */
QStatusBar {
    background-color: #201D18;
    color: #887A6A;
    border-top: 1px solid #2A241D;
    font-size: 12px;
}

/* ── Labels ── */
QLabel {
    color: #EDE4D8;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background-color: #171410;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #352E24;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #7A5C3A;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #171410;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #352E24;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #7A5C3A;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── ProjectDialog ── */
#dlgHeader {
    background-color: #201D18;
    font-size: 15px;
    font-weight: bold;
    border-bottom: 1px solid #2A241D;
}
#dlgSearch {
    background-color: #201D18;
    border: 1px solid #2A241D;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
#dlgSearch:focus {
    border-color: #C49A6C;
}
#dlgList {
    border: none;
    background-color: #171410;
    alternate-background-color: #1E1B16;
    outline: none;
    font-size: 13px;
}
#dlgList::item {
    padding: 0;
    border: none;
}
#dlgList::item:selected {
    background-color: #2A241D;
}
#dlgList::item:hover:!selected {
    background-color: #201D18;
}
#dlgName {
    font-size: 13px;
    font-weight: bold;
    color: #EDE4D8;
}
#dlgDetail {
    font-size: 11px;
    color: #C0B4A4;
}
#dlgIcon {
    font-size: 22px;
}
#dlgSep {
    background-color: #2A241D;
    margin: 0 16px;
}
#dlgCancel {
    background-color: #352E24;
    color: #EDE4D8;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-size: 13px;
}
#dlgCancel:hover {
    background-color: #7A5C3A;
}
