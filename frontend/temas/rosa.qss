/* Open APU Studio — Rosa Theme */
/* Palette: warm pink tones */

* {
    font-family: "Inter", "Segoe UI", "Segoe UI Variable Text", sans-serif;
    color: #F0E2EA;
}

QMainWindow, QDialog, QWidget {
    background-color: #1A1218;
    color: #F0E2EA;
}

/* ── Barra superior ── */
QMenuBar {
    background-color: #231A20;
    color: #F0E2EA;
    border-bottom: 1px solid #2E1F28;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected {
    background-color: #2E1F28;
    border-radius: 4px;
}
QMenu {
    background-color: #231A20;
    color: #F0E2EA;
    border: 1px solid #2E1F28;
    padding: 4px;
}
QMenu::item:selected {
    background-color: #2E1F28;
    border-radius: 4px;
}

/* ── Toolbar ── */
#tbCustom {
    background-color: #2E1F28;
    border-bottom: 1px solid #2E1F28;
}
#tbCustom > QWidget {
    background-color: transparent;
}
#tbGroup, #tbGroup * {
    background-color: transparent;
    border: none;
}

#tbSep {
    background-color: #2E1F28;
    margin: 4px 6px;
}

/* ── Pestañas superiores (PROYECTO, INICIO, …) ── */
#tabBar {
    background-color: #231A20;
    border-bottom: 1px solid #2E1F28;
}
#tabBar QPushButton {
    background-color: transparent;
    color: #C8B0BE;
    border: none;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 18px;
}
#tabBar QPushButton:hover {
    color: #F0E2EA;
    background-color: #2E1F28;
}
#tabBar QPushButton:checked {
    color: #D48FB7;
    background-color: #1A1218;
}

/* ── Search bar ── */
#searchBar {
    background-color: #231A20;
    border-bottom: 1px solid #2E1F28;
}
#searchInput {
    background-color: #1A1218;
    color: #F0E2EA;
    border: 1px solid #3A2530;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    min-height: 20px;
}
#searchInput:focus {
    border: 1px solid #B06A90;
}
QToolButton {
    background-color: transparent;
    color: #F0E2EA;
    border: none;
    outline: none;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10px;
    min-height: 40px;
    min-width: 48px;
}
QToolButton:hover {
    background-color: #2E1F28;
}
#tbStackedBtn {
    padding: 0 6px;
    text-align: left;
    min-height: 0px;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #2E1F28;
    width: 2px;
}

/* ── Tablas y árbol ── */
QTreeView, QTableView {
    background-color: #1A1218;
    alternate-background-color: #22171E;
    color: #F0E2EA;
    gridline-color: #2E1F28;
    selection-background-color: #8F4E6B;
    selection-color: #F0E2EA;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 4px 8px;
    min-height: 28px;
    border: none;
}
QTreeView::item:hover {
    background: #281D22;
}
QTreeView::item:selected {
    background: #3A2530;
}
QTreeView::item:selected:focus {
    background: #B07A98;
}
QTreeView::branch {
    background: transparent;
}
QTreeView::branch:hover {
    background: #281D22;
}
QTreeView::branch:selected {
    background: #3A2530;
}
QHeaderView::section {
    background-color: #2E1F28;
    color: #F0E2EA;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #3A2530;
    border-right: 1px solid #3A2530;
    font-weight: bold;
    font-size: 12px;
}

/* ── Pestañas ── */
QTabWidget::pane {
    background-color: #1A1218;
    border: none;
    border-top: 1px solid #2E1F28;
}
QTabBar::tab {
    background-color: #231A20;
    color: #C8B0BE;
    padding: 8px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-size: 13px;
}
QTabBar::tab:selected {
    color: #D48FB7;
    border-bottom: 2px solid #B06A90;
    background-color: #1A1218;
}
QTabBar::tab:hover {
    color: #F0E2EA;
}

/* ── Botones ── */
QPushButton {
    background-color: transparent;
    color: #F0E2EA;
    border: 1px solid #3A2530;
    border-radius: 4px;
    padding: 4px 16px;
    font-size: 13px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #2E1F28;
    border-color: #B06A90;
}
QPushButton:pressed {
    background-color: #3A2530;
}
QPushButton#btnPrimario {
    background-color: #8F4E6B;
    color: #F0E2EA;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}
QPushButton#btnPrimario:hover {
    background-color: #B06A90;
}

/* ── Inputs ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1A1218;
    color: #F0E2EA;
    border: 1px solid #2E1F28;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #B06A90;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8F7080;
    margin-right: 4px;
}
QComboBox:hover::down-arrow {
    border-top-color: #F0E2EA;
}

/* ── GroupBox ── */
QGroupBox {
    border: none;
    font-weight: bold;
    font-size: 13px;
    margin-top: 12px;
    padding-top: 4px;
}

/* ── StatusBar ── */
QStatusBar {
    background-color: #231A20;
    color: #8F7080;
    border-top: 1px solid #2E1F28;
    font-size: 12px;
}

/* ── Labels ── */
QLabel {
    color: #F0E2EA;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background-color: #1A1218;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #3A2530;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #8F4E6B;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #1A1218;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #3A2530;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #8F4E6B;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── ProjectDialog ── */
#dlgHeader {
    background-color: #231A20;
    font-size: 15px;
    font-weight: bold;
    border-bottom: 1px solid #2E1F28;
}
#dlgSearch {
    background-color: #231A20;
    border: 1px solid #2E1F28;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
#dlgSearch:focus {
    border-color: #D48FB7;
}
#dlgList {
    border: none;
    background-color: #1A1218;
    alternate-background-color: #22171E;
    outline: none;
    font-size: 13px;
}
#dlgList::item {
    padding: 0;
    border: none;
}
#dlgList::item:selected {
    background-color: #2E1F28;
}
#dlgList::item:hover:!selected {
    background-color: #231A20;
}
#dlgName {
    font-size: 13px;
    font-weight: bold;
    color: #F0E2EA;
}
#dlgDetail {
    font-size: 11px;
    color: #C8B0BE;
}
#dlgIcon {
    font-size: 22px;
}
#dlgSep {
    background-color: #2E1F28;
    margin: 0 16px;
}
#dlgCancel {
    background-color: #3A2530;
    color: #F0E2EA;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-size: 13px;
}
#dlgCancel:hover {
    background-color: #8F4E6B;
}

/* ── DialogoAjustes ── */
#dlgAjustes {
    background-color: #1A1218;
}
#dlgAjustesHeader {
    background-color: #231A20;
    border-bottom: 1px solid #2E1F28;
}
#dlgAjustesHeader QLabel#dlgHeader {
    font-size: 15px;
    font-weight: bold;
    color: #F0E2EA;
}
#dlgAjustesBody {
    background-color: #1A1218;
}
#dlgCard {
    background-color: #231A20;
    border: 1px solid #2E1F28;
    border-radius: 6px;
}
#dlgCardTitle {
    font-size: 13px;
    font-weight: bold;
    color: #F0E2EA;
}
#dlgAjustesFooter {
    background-color: #231A20;
}
#dlgAjustesNav {
    background-color: #231A20;
    border: none;
    border-right: 1px solid #2E1F28;
    outline: none;
    font-size: 13px;
    padding: 4px 0;
}
#dlgAjustesNav::item {
    padding: 8px 12px;
    border: none;
}
#dlgAjustesNav::item:selected {
    background-color: #2E1F28;
    color: #F0E2EA;
}
#dlgAjustesNav::item:hover:!selected {
    background-color: #1A1218;
}
#dlgVSep {
    background-color: #2E1F28;
    max-width: 1px;
}
