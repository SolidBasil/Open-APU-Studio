/* Open APU Studio — Dark Mode *//* Palette original: docs/Guia diseño.md sección 3 */* {    font-family: "Inter", "Segoe UI", "Segoe UI Variable Text", sans-serif;    color: #E8EDF2;}QMainWindow, QDialog, QWidget {    background-color: #12161D;    color: #E8EDF2;}/* ── Barra superior ── */QMenuBar {    background-color: #1B2330;    color: #E8EDF2;    border-bottom: 1px solid #203244;    padding: 2px 8px;    font-size: 13px;}QMenuBar::item:selected {    background-color: #203244;    border-radius: 4px;}QMenu {    background-color: #1B2330;    color: #E8EDF2;    border: 1px solid #203244;    padding: 4px;}QMenu::item:selected {    background-color: #203244;    border-radius: 4px;}/* ── Toolbar ── */#tbCustom {    background-color: #1F2A38;    border-bottom: 1px solid #203244;}#tbCustom > QWidget {    background-color: transparent;}#tbGroup, #tbGroup * {    background-color: transparent;    border: none;}#tbSep {    background-color: #203244;    margin: 4px 6px;}/* ── Pestañas superiores (PROYECTO, INICIO, …) ── */#tabBar {    background-color: #1B2330;    border-bottom: 1px solid #203244;}#tabBar QPushButton {    background-color: transparent;    color: #B7C0C8;    border: none;    padding: 3px 14px;    font-size: 12px;    font-weight: 600;    min-height: 18px;}#tabBar QPushButton:hover {    color: #E8EDF2;    background-color: #203244;}#tabBar QPushButton:checked {    color: #7FAFD6;    background-color: #12161D;}/* ── Search bar ── */#searchBar {    background-color: #1B2330;    border-bottom: 1px solid #203244;}#searchInput {    background-color: #12161D;    color: #E8EDF2;    border: 1px solid #2A4158;    border-radius: 6px;    padding: 5px 10px;    font-size: 13px;    min-height: 20px;}#searchInput:focus {    border: 1px solid #5A82AB;}QToolButton {    background-color: transparent;    color: #E8EDF2;    border: none;    outline: none;    border-radius: 4px;    padding: 4px 6px;    font-size: 10px;    min-height: 40px;    min-width: 48px;}QToolButton:hover {    background-color: #203244;}#tbStackedBtn {    padding: 0 6px;    text-align: left;    min-height: 0px;}/* ── Splitter ── */QSplitter::handle {    background-color: #203244;    width: 2px;}/* ── Tablas y árbol ── */QTreeView, QTableView {    background-color: #12161D;    alternate-background-color: #19212E;    color: #E8EDF2;    gridline-color: #203244;    selection-background-color: #37628F;    selection-color: #E8EDF2;    border: none;    outline: none;    font-size: 13px;}QTreeView::item {    padding: 4px 8px;    min-height: 28px;    border: none;}QTreeView::item:hover {    background: #1E2A3A;}QTreeView::item:selected {    background: #2A4158;}QTreeView::item:selected:focus {    background: #4A6FA5;}QTreeView::branch {    background: transparent;}QTreeView::branch:hover {    background: #1E2A3A;}QTreeView::branch:selected {    background: #2A4158;}QHeaderView::section {    background-color: #203244;    color: #E8EDF2;    padding: 6px 10px;    border: none;    border-bottom: 1px solid #2A4158;    border-right: 1px solid #2A4158;    font-weight: bold;    font-size: 12px;}/* ── Pestañas ── */QTabWidget::pane {    background-color: #12161D;    border: none;    border-top: 1px solid #203244;}QTabBar::tab {    background-color: #1B2330;    color: #B7C0C8;    padding: 8px 18px;    border: none;    border-bottom: 2px solid transparent;    margin-right: 2px;    font-size: 13px;}QTabBar::tab:selected {    color: #7FAFD6;    border-bottom: 2px solid #5A82AB;    background-color: #12161D;}QTabBar::tab:hover {    color: #E8EDF2;}/* ── Botones ── */QPushButton {    background-color: transparent;    color: #E8EDF2;    border: 1px solid #2A4158;    border-radius: 4px;    padding: 4px 16px;    font-size: 13px;    min-height: 28px;}QPushButton:hover {    background-color: #203244;    border-color: #5A82AB;}QPushButton:pressed {    background-color: #2A4158;}QPushButton#btnPrimario {    background-color: #37628F;    color: #E8EDF2;    border: none;    border-radius: 4px;    padding: 6px 16px;}QPushButton#btnPrimario:hover {    background-color: #5A82AB;}/* ── Inputs ── */QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {    background-color: #12161D;    color: #E8EDF2;    border: 1px solid #203244;    border-radius: 4px;    padding: 4px 8px;    font-size: 13px;}QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {    border: 1px solid #5A82AB;}QComboBox::drop-down {    border: none;    width: 20px;}QComboBox::down-arrow {    image: none;    border-left: 5px solid transparent;    border-right: 5px solid transparent;    border-top: 6px solid #6B7884;    margin-right: 4px;}QComboBox:hover::down-arrow {    border-top-color: #E8EDF2;}/* ── GroupBox ── */QGroupBox {    border: none;    font-weight: bold;    font-size: 13px;    margin-top: 12px;    padding-top: 4px;}/* ── Checkboxes & RadioButtons ── */QRadioButton, QCheckBox {    spacing: 8px;    font-size: 13px;    min-height: 26px;    color: #E8EDF2;}QRadioButton::indicator, QCheckBox::indicator {    width: 18px;    height: 18px;    border: 2px solid #2A4158;    background-color: #12161D;}QCheckBox::indicator {    border-radius: 4px;}QRadioButton::indicator {    border-radius: 10px;}QRadioButton::indicator:checked, QCheckBox::indicator:checked {    background-color: #37628F;    border-color: #5A82AB;}QRadioButton::indicator:hover, QCheckBox::indicator:hover {    border-color: #5A82AB;}/* ── DialogoExplosion ── */#dlgInfo {    color: #B7C0C8;    font-size: 12px;    padding: 10px 16px;    background-color: #1B2330;    border-radius: 6px;}#dlgCalc, #dlgTipos {    background-color: #1B2330;    border-radius: 6px;    padding: 12px;    margin-top: 4px;}/* ── StatusBar ── */QStatusBar {    background-color: #1B2330;    color: #6B7884;    border-top: 1px solid #203244;    font-size: 12px;}/* ── Labels ── */QLabel {    color: #E8EDF2;}/* ── Scrollbars ── */QScrollBar:vertical {    background-color: #12161D;    width: 10px;    border: none;}QScrollBar::handle:vertical {    background-color: #2A4158;    border-radius: 5px;    min-height: 20px;}QScrollBar::handle:vertical:hover {    background-color: #37628F;}QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {    height: 0;}QScrollBar:horizontal {    background-color: #12161D;    height: 10px;    border: none;}QScrollBar::handle:horizontal {    background-color: #2A4158;    border-radius: 5px;    min-width: 20px;}QScrollBar::handle:horizontal:hover {    background-color: #37628F;}QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {    width: 0;}/* ── ProjectDialog ── */#dlgHeader {    background-color: #1B2330;    font-size: 15px;    font-weight: bold;    border-bottom: 1px solid #203244;}#dlgSearch {    background-color: #1B2330;    border: 1px solid #203244;    border-radius: 4px;    padding: 6px 10px;    font-size: 13px;}#dlgSearch:focus {    border-color: #7FAFD6;}#dlgList {    border: none;    background-color: #12161D;    alternate-background-color: #19212E;    outline: none;    font-size: 13px;}#dlgList::item {    padding: 0;    border: none;}#dlgList::item:selected {    background-color: #203244;}#dlgList::item:hover:!selected {    background-color: #1B2330;}#dlgName {    font-size: 13px;    font-weight: bold;    color: #E8EDF2;}#dlgDetail {    font-size: 11px;    color: #B7C0C8;}#dlgIcon {    font-size: 22px;}#dlgSep {    background-color: #203244;    margin: 0 16px;}#dlgCancel {    background-color: #2A4158;    color: #E8EDF2;    border: none;    border-radius: 4px;    padding: 6px 20px;    font-size: 13px;}#dlgCancel:hover {    background-color: #37628F;}/* ── DialogoAjustes ── */#dlgAjustes {    background-color: #12161D;}#dlgAjustesHeader {    background-color: #1B2330;    border-bottom: 1px solid #203244;}#dlgAjustesHeader QLabel#dlgHeader {    font-size: 15px;    font-weight: bold;    color: #E8EDF2;}#dlgAjustesBody {    background-color: #12161D;}#dlgCard {    background-color: #1B2330;    border: 1px solid #203244;    border-radius: 6px;}#dlgCardTitle {    font-size: 13px;    font-weight: bold;    color: #E8EDF2;}#dlgAjustesFooter {    background-color: #1B2330;}#dlgAjustesNav {    background-color: #1B2330;    border: none;    border-right: 1px solid #203244;    outline: none;    font-size: 13px;    padding: 4px 0;}#dlgAjustesNav::item {    padding: 8px 12px;    border: none;}#dlgAjustesNav::item:selected {    background-color: #203244;    color: #E8EDF2;}#dlgAjustesNav::item:hover:!selected {    background-color: #19212E;}#dlgVSep {    background-color: #203244;    max-width: 1px;}