/* Open APU Studio — Light Mode */
/* Palette: docs/Guia diseño.md sección 17 */

* {
    font-family: "Inter", "Segoe UI", "Segoe UI Variable Text", sans-serif;
    color: #1A1F24;
}

QMainWindow, QDialog, QWidget {
    background-color: #F4F1EC;
    color: #1A1F24;
}

/* ── Barra superior ── */
QMenuBar {
    background-color: #2C5F8A;
    color: #FFFFFF;
    border-bottom: 1px solid #1E4668;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected {
    background-color: #3B6EA0;
    border-radius: 4px;
}
QMenu {
    background-color: #FFFFFF;
    color: #1A1F24;
    border: 1px solid #C8C0B4;
    padding: 4px;
}
QMenu::item:selected {
    background-color: #B8D0E6;
    border-radius: 4px;
}

/* ── Toolbar ── */
#tbCustom {
    background-color: #326A97;
    border-bottom: 1px solid #1E4668;
}
#tbCustom > QWidget {
    background-color: transparent;
}
#tbGroup, #tbGroup * {
    background-color: transparent;
    border: none;
}

#tbSep {
    background-color: #1E4668;
    margin: 4px 6px;
}
QToolButton {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    outline: none;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10px;
    min-height: 40px;
    min-width: 48px;
}
QToolButton:hover {
    background-color: #3B6EA0;
}
#tbStackedBtn {
    padding: 0 6px;
    text-align: left;
    min-height: 0px;
}

/* ── Pestañas superiores (PROYECTO, INICIO, …) ── */
#tabBar {
    background-color: #2C5F8A;
    border-bottom: 1px solid #1E4668;
}
#tabBar QPushButton {
    background-color: transparent;
    color: #C0D8EC;
    border: none;
    padding: 3px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 18px;
}
#tabBar QPushButton:hover {
    color: #FFFFFF;
    background-color: #3B6EA0;
}
#tabBar QPushButton:checked {
    color: #FFFFFF;
    background-color: #1E4668;
}

/* ── Search bar ── */
#searchBar {
    background-color: #2C5F8A;
    border-bottom: 1px solid #1E4668;
}
#searchInput {
    background-color: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #B8C9D9;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    min-height: 20px;
}
#searchInput:focus {
    border: 1px solid #2C5F8A;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #C8C0B4;
    width: 2px;
}

/* ── Tablas y árbol ── */
QTreeView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F4F1EC;
    color: #1A1F24;
    gridline-color: #E0DBD2;
    selection-background-color: #B8D0E6;
    selection-color: #1A1F24;
    border: none;
    outline: none;
    font-size: 13px;
}
QTreeView::item {
    padding: 4px 2px;
    min-height: 28px;
    border: none;
}
QTreeView::item:hover {
    background: #EBE7DF;
}
QTableWidget::item:hover {
    background: #EBE7DF;
}
QTreeView::item:selected {
    background: #D0DCE8;
}
QTreeView::item:selected:focus {
    background: #A8C4E0;
}
QTreeView::branch {
    background: transparent;
}
QTreeView::branch:hover {
    background: #EBE7DF;
}
QTreeView::branch:selected {
    background: #D0DCE8;
}
QTableWidget::item:selected {
    background: #D0DCE8;
}
QTableWidget::item:selected:focus {
    background: #A8C4E0;
}
QHeaderView::section {
    background-color: #CDD5DC;
    color: #1A1F24;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #B8C0C8;
    border-right: 1px solid #B8C0C8;
    font-weight: bold;
    font-size: 12px;
}

/* ── Pestañas ── */
QTabWidget::pane {
    background-color: #F4F1EC;
    border: none;
    border-top: 1px solid #C8C0B4;
}
QTabBar::tab {
    background-color: #E8E2D8;
    color: #5A6068;
    padding: 8px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
    font-size: 13px;
}
QTabBar::tab:selected {
    color: #3B6EA0;
    border-bottom: 2px solid #3B6EA0;
    background-color: #F4F1EC;
}
QTabBar::tab:hover {
    color: #1A1F24;
}

/* ── Botones ── */
QPushButton {
    background-color: transparent;
    color: #1A1F24;
    border: 1px solid #C8C0B4;
    border-radius: 4px;
    padding: 4px 16px;
    font-size: 13px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #E0DBD2;
    border-color: #3B6EA0;
}
QPushButton:pressed {
    background-color: #D0CCC4;
}
QPushButton#btnPrimario {
    background-color: #3B6EA0;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}
QPushButton#btnPrimario:hover {
    background-color: #4A7FB5;
}

/* ── Inputs ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #FFFFFF;
    color: #1A1F24;
    border: 1px solid #C8C0B4;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #3B6EA0;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 20px;
}

/* ── GroupBox ── */
QGroupBox {
    border: none;
    font-weight: bold;
    font-size: 13px;
    margin-top: 16px;
    padding-top: 10px;
}

/* ── Checkboxes & RadioButtons ── */
QRadioButton, QCheckBox {
    spacing: 8px;
    font-size: 13px;
    min-height: 26px;
    color: #1A1F24;
}
QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #C8C0B4;
    background-color: #FFFFFF;
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 10px;
}
QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    background-color: #2C5F8A;
    border-color: #1E4668;
}
QRadioButton::indicator:hover, QCheckBox::indicator:hover {
    border-color: #4A7FB5;
}

/* ── DialogoExplosion ── */
#dlgInfo {
    color: #5A6068;
    font-size: 12px;
    padding: 10px 16px;
    background-color: #E0DBD2;
    border-radius: 6px;
}
#dlgCalc, #dlgTipos {
    background-color: #EBE7DF;
    border-radius: 6px;
    padding: 12px;
    margin-top: 4px;
}

/* ── StatusBar ── */
QStatusBar {
    background-color: #2C5F8A;
    color: #D0E0F0;
    border-top: 1px solid #1E4668;
    font-size: 12px;
}

/* ── Labels ── */
QLabel {
    color: #1A1F24;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background-color: #F4F1EC;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #C8C0B4;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #8A9499;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background-color: #F4F1EC;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #C8C0B4;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #8A9499;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── ProjectDialog ── */
#dlgHeader {
    background-color: #E8E2D8;
    font-size: 15px;
    font-weight: bold;
    border-bottom: 1px solid #C8C0B4;
}
#dlgSearch {
    background-color: #FFFFFF;
    border: 1px solid #C8C0B4;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
#dlgSearch:focus {
    border-color: #3B6EA0;
}
#dlgList {
    border: none;
    background-color: #FFFFFF;
    alternate-background-color: #F4F1EC;
    outline: none;
    font-size: 13px;
}
#dlgList::item {
    padding: 0;
    border: none;
}
#dlgList::item:selected {
    background-color: #D0DCE8;
}
#dlgList::item:hover:!selected {
    background-color: #EBE7DF;
}
#dlgName {
    font-size: 13px;
    font-weight: bold;
    color: #1A1F24;
}
#dlgDetail {
    font-size: 11px;
    color: #6A7078;
}
#dlgIcon {
    font-size: 22px;
}
#dlgSep {
    background-color: #C8C0B4;
    margin: 0 16px;
}
#dlgCancel {
    background-color: #CDD5DC;
    color: #1A1F24;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-size: 13px;
}
#dlgCancel:hover {
    background-color: #B8C0C8;
}

/* ── DialogoAjustes ── */
#dlgAjustes {
    background-color: #F4F1EC;
}
#dlgAjustesHeader {
    background-color: #E8E2D8;
    border-bottom: 1px solid #C8C0B4;
}
#dlgAjustesHeader QLabel#dlgHeader {
    font-size: 15px;
    font-weight: bold;
    color: #1A1F24;
}
#dlgAjustesBody {
    background-color: #F4F1EC;
}
#dlgCard {
    background-color: #FFFFFF;
    border: 1px solid #C8C0B4;
    border-radius: 6px;
}
#dlgCardTitle {
    font-size: 13px;
    font-weight: bold;
    color: #1A1F24;
}
#dlgAjustesFooter {
    background-color: #E8E2D8;
}
#dlgAjustesNav {
    background-color: #E8E2D8;
    border: none;
    border-right: 1px solid #C8C0B4;
    outline: none;
    font-size: 13px;
    padding: 4px 0;
}
#dlgAjustesNav::item {
    padding: 8px 12px;
    border: none;
}
#dlgAjustesNav::item:selected {
    background-color: #CDD5DC;
    color: #1A1F24;
}
#dlgAjustesNav::item:hover:!selected {
    background-color: #F4F1EC;
}
#dlgVSep {
    background-color: #C8C0B4;
    max-width: 1px;
}
